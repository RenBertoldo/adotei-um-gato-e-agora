---
const plans = [
  {
    name: 'Starter',
    price: '0',
    description: 'Perfect for side projects and early experiments.',
    cta: 'Get started free',
    ctaVariant: 'outline' as const,
    features: [
      '3 projects',
      '1 team member',
      '5 GB storage',
      'Community support',
      'Basic analytics',
    ],
    highlighted: false,
  },
  {
    name: 'Pro',
    price: '29',
    description: 'For growing teams that need more power and flexibility.',
    cta: 'Start free trial',
    ctaVariant: 'primary' as const,
    features: [
      'Unlimited projects',
      'Up to 10 team members',
      '100 GB storage',
      'Priority support',
      'Advanced analytics',
      'CI/CD pipelines',
      'Custom domains',
    ],
    highlighted: true,
  },
  {
    name: 'Enterprise',
    price: '99',
    description: 'For large teams with advanced security and compliance needs.',
    cta: 'Contact sales',
    ctaVariant: 'outline' as const,
    features: [
      'Unlimited everything',
      'Unlimited team members',
      'SSO & SAML',
      'Dedicated support',
      'SLA guarantee',
      'Custom contracts',
      'Audit logs',
    ],
    highlighted: false,
  },
];
---

<section class="pricing" id="pricing">
  <div class="container">
    <div class="section-header">
      <h2>Simple, transparent pricing</h2>
      <p>No hidden fees. No surprises. Upgrade or downgrade at any time.</p>
    </div>

    <div class="grid">
      {plans.map(({ name, price, description, cta, ctaVariant, features, highlighted }) => (
        <div class:list={['card', { highlighted }]}>
          {highlighted && <div class="badge">Most popular</div>}
          <div class="plan-header">
            <h3>{name}</h3>
            <div class="price">
              <span class="dollar">$</span>
              <span class="amount">{price}</span>
              <span class="period">/mo</span>
            </div>
            <p class="description">{description}</p>
          </div>

          <a href="#" class:list={['cta', ctaVariant === 'primary' ? 'btn-primary' : 'btn-outline']}>
            {cta}
          </a>

          <ul class="feature-list">
            {features.map((feature) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <circle cx="8" cy="8" r="7" stroke="var(--color-accent)" stroke-width="1.5" />
                  <path d="M5 8l2 2 4-4" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: 5rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 520px;
    margin: 0 auto 3.5rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .section-header p {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .card {
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card.highlighted {
    border-color: var(--color-accent);
    background-color: rgba(124, 111, 255, 0.06);
  }

  .badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    font-weight: 600;
    background-color: var(--color-accent);
    color: white;
    padding: 0.2rem 0.85rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .plan-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    line-height: 1;
  }

  .dollar {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .amount {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .period {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .description {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .btn-primary {
    text-align: center;
    font-weight: 600;
    font-size: 0.9rem;
    background-color: var(--color-accent);
    color: white;
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s;
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn-outline {
    text-align: center;
    font-weight: 500;
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.7rem 1.5rem;
    border-radius: var(--radius-sm);
    transition: border-color 0.15s, background-color 0.15s;
  }

  .btn-outline:hover {
    border-color: var(--color-muted);
    background-color: rgba(255, 255, 255, 0.04);
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .feature-list svg {
    flex-shrink: 0;
  }
</style>
