---
import { Image } from 'astro:assets';
import imgDesktop from '../assets/images/Imagem9.webp';
import imgMobile from '../assets/images/Imagem9A.webp';
---

<section class="cta" id="cta">
  <div class="container">
    <div class="mobile-image">
      <Image
        src={imgMobile}
        alt="Adotei um gato, e agora? — eBook da Bia Morais em múltiplos formatos"
        loading="lazy"
      />
    </div>

    <div class="content">
      <h2>
        Seu gato depende de você para ter uma
        <em>vida saudável e feliz.</em>
      </h2>
      <p>Comece da forma certa hoje mesmo!</p>
      <a href="https://pay.hotmart.com/N105362193D" class="btn-cta">QUERO MEU EBOOK AGORA!</a>
      <p class="fine-print">
        Acesso imediato após a compra &bull; Formato PDF &bull; Garantia de 7 dias
      </p>
    </div>

    <div class="image-wrapper">
      <Image
        src={imgDesktop}
        alt="Adotei um gato, e agora? — eBook da Bia Morais em múltiplos formatos"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .cta {
    background-color: var(--color-surface-alt);
    overflow: hidden;
  }

  .container {
    display: flex;
    align-items: stretch;
    gap: 3rem;
    padding-right: 0;
  }

  .content {
    flex: 0 0 auto;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 5rem 0;
    min-width: 40rem;
    padding-left: 10rem;
  }

  h2 {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  h2 em {
    font-style: normal;
    color: var(--color-warm);
  }

  p {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-muted);
  }

  .btn-cta {
    display: inline-block;
    font-weight: 800;
    font-size: 1.05rem;
    background-color: var(--color-accent);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: var(--radius-sm);
    align-self: flex-start;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: background-color 0.15s, transform 0.1s, box-shadow 0.15s;
    box-shadow: 0 4px 20px rgba(125, 34, 66, 0.3);
  }

  .btn-cta:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(125, 34, 66, 0.4);
  }

  .fine-print {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .mobile-image {
    display: none;
  }

  .image-wrapper {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    transition: flex 0.3s ease;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    display: block;
  }

  @media (max-width: 768px) {
    .container {
      flex-direction: column;
      padding: 0;
    }

    .mobile-image {
      display: block;
      width: 100%;
    }

    .mobile-image img {
      width: 100%;
      height: auto;
      display: block;
    }

    .image-wrapper {
      display: none;
    }

    .content {
      max-width: 100%;
      min-width: 0;
      padding: 1.5rem 2rem 2.5rem;
    }
  }
</style>
