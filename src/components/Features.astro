---
const features = [
  {
    icon: '⚡',
    title: 'Instant deploys',
    description:
      'Push to main and your changes are live in seconds. Zero-downtime deployments with automatic rollbacks.',
  },
  {
    icon: '🔒',
    title: 'Enterprise security',
    description:
      'SOC 2 Type II certified. End-to-end encryption, SSO, RBAC, and audit logs out of the box.',
  },
  {
    icon: '📊',
    title: 'Real-time analytics',
    description:
      'Monitor every request, track errors, and understand usage patterns with a built-in observability dashboard.',
  },
  {
    icon: '🔁',
    title: 'CI/CD pipelines',
    description:
      'Pre-built pipeline templates for any stack. Run tests, lint, and deploy automatically on every push.',
  },
  {
    icon: '🧩',
    title: 'Integrations',
    description:
      'Connect to Slack, GitHub, Linear, Jira, Datadog, and 100+ tools with one click.',
  },
  {
    icon: '🌍',
    title: 'Global edge network',
    description:
      'Serve users from 30+ regions with automatic geo-routing and CDN caching built in.',
  },
];
---

<section class="features" id="features">
  <div class="container">
    <div class="section-header">
      <h2>Everything your team needs</h2>
      <p>Stop stitching together dozens of tools. Launchpad gives you a cohesive platform that works out of the box.</p>
    </div>

    <div class="grid">
      {features.map(({ icon, title, description }) => (
        <div class="card">
          <div class="icon">{icon}</div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding: 5rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 3.5rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .section-header p {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .card {
    background-color: var(--color-bg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: background-color 0.15s;
  }

  .card:hover {
    background-color: var(--color-surface);
  }

  .icon {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .card h3 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .card p {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.65;
  }
</style>
