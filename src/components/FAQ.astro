---
const faqs = [
  {
    question: 'Is there a free plan?',
    answer:
      'Yes. Our Starter plan is free forever with no credit card required. You can upgrade at any time as your team grows.',
  },
  {
    question: 'Can I cancel anytime?',
    answer:
      'Absolutely. There are no long-term contracts. You can cancel or downgrade your plan at any time, and your account will remain active until the end of the billing period.',
  },
  {
    question: 'How does team billing work?',
    answer:
      'Plans are billed per workspace, not per seat. Add as many team members as your plan allows without paying per-user fees.',
  },
  {
    question: 'Do you offer discounts for startups or open source?',
    answer:
      'Yes. We offer 50% off for qualifying startups (under 2 years old, pre-Series A) and free Pro plans for active open source projects. Contact us to apply.',
  },
  {
    question: 'What kind of support do you offer?',
    answer:
      'Starter plans have access to our community forums and docs. Pro plans include priority email support with a 24-hour response SLA. Enterprise plans get a dedicated support engineer.',
  },
];
---

<section class="faq" id="faq">
  <div class="container">
    <div class="section-header">
      <h2>Frequently asked questions</h2>
      <p>Can't find your answer? <a href="#">Chat with our team &rarr;</a></p>
    </div>

    <div class="list">
      {faqs.map(({ question, answer }) => (
        <details class="item">
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: 5rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: 700px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .section-header p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .section-header a {
    color: var(--color-accent-hover);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .item {
    background-color: var(--color-surface);
    padding: 1.25rem 1.5rem;
    transition: background-color 0.15s;
  }

  .item[open] {
    background-color: var(--color-bg);
  }

  summary {
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    color: var(--color-muted);
    font-size: 1.2rem;
    font-weight: 400;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .item[open] summary::after {
    transform: rotate(45deg);
  }

  .item p {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
